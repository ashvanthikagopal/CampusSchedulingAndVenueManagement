# Database configuration (supports SQLite for instant local dev & MySQL for production)
DATABASE_URL=sqlite:///./cit_scheduler.db
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/cit_scheduler

# JWT Auth
JWT_SECRET=your-secret-key-at-least-32-chars-long-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Configuration (Primary: Groq, Secondary: Gemini, Fallback: Deterministic)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash


# Solver settings
SOLVER_TIME_LIMIT_SECONDS=60
SOLVER_WORKERS=8
SOLVER_RANDOM_SEED=42

# Demo configuration
DEMO_TODAY_DATE=2027-01-25
DEMO_MODE=true

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

